  <script>
    // -------------------------------------------------------
    // 1. HAMBURGER MENU TOGGLE
    // -------------------------------------------------------
    const hamburger  = document.getElementById('hamburger');
    const mobileNav  = document.getElementById('mobileNav');

    hamburger.addEventListener('click', () => {
      mobileNav.classList.toggle('open');
    });

    // Close mobile nav helper (called from inline onclick)
    function closeMobileNav() {
      mobileNav.classList.remove('open');
    }

    // -------------------------------------------------------
    // 2. SMOOTH ACTIVE NAV LINK ON SCROLL
    // -------------------------------------------------------
    const sections   = document.querySelectorAll('section[id]');
    const navLinks   = document.querySelectorAll('.nav-links a');

    function onScroll() {
      let current = '';
      sections.forEach(sec => {
        if (window.scrollY >= sec.offsetTop - 100) current = sec.getAttribute('id');
      });
      navLinks.forEach(a => {
        a.classList.remove('active');
        if (a.getAttribute('href') === '#' + current) a.classList.add('active');
      });
    }

    window.addEventListener('scroll', onScroll);

    // -------------------------------------------------------
    // 3. WELCOME INTERACTIVE BUTTON
    // -------------------------------------------------------
    function showWelcome() {
      const msg = document.getElementById('welcomeMsg');
      const btn = document.getElementById('welcomeBtn');
      msg.style.display = 'block';
      btn.textContent   = '✅ Welcome Shown!';
      btn.disabled      = true;
    }

    // -------------------------------------------------------
    // 4. CONTACT FORM VALIDATION & SUBMISSION
    // -------------------------------------------------------
    function validateField(id, groupId, checkFn) {
      /* Marks a field group as error / valid. Returns boolean. */
      const grp  = document.getElementById(groupId);
      const pass = checkFn(document.getElementById(id).value.trim());
      grp.classList.toggle('has-error', !pass);
      return pass;
    }

    function isEmail(val) {
      /* Basic email regex check */
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
    }

    function isPhone(val) {
      /* Allow digits, spaces, +, dashes, parens — min 7 chars */
      return /^[\d\s\+\-\(\)]{7,}$/.test(val);
    }

    function submitForm() {
      /* Run all validations */
      const v1 = validateField('name',    'grp-name',    v => v.length >= 2);
      const v2 = validateField('email',   'grp-email',   v => isEmail(v));
      const v3 = validateField('phone',   'grp-phone',   v => isPhone(v));
      const v4 = validateField('subject', 'grp-subject', v => v !== '');
      const v5 = validateField('message', 'grp-message', v => v.length >= 10);

      if (!(v1 && v2 && v3 && v4 && v5)) return; // Stop if any field invalid

      /* All valid — show success UI and clear the form */
      document.getElementById('formSuccess').style.display = 'block';
      ['name','email','phone','message'].forEach(id => document.getElementById(id).value = '');
      document.getElementById('subject').selectedIndex = 0;

      /* Scroll success message into view */
      document.getElementById('formSuccess').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // -------------------------------------------------------
    // 5. REAL-TIME INLINE VALIDATION (on input blur)
    // -------------------------------------------------------
    document.getElementById('name')   .addEventListener('blur', () => validateField('name',    'grp-name',    v => v.length >= 2));
    document.getElementById('email')  .addEventListener('blur', () => validateField('email',   'grp-email',   v => isEmail(v)));
    document.getElementById('phone')  .addEventListener('blur', () => validateField('phone',   'grp-phone',   v => isPhone(v)));
    document.getElementById('subject').addEventListener('change', () => validateField('subject','grp-subject', v => v !== ''));
    document.getElementById('message').addEventListener('blur', () => validateField('message', 'grp-message', v => v.length >= 10));
  </script>

